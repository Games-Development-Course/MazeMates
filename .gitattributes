*.tga filter=lfs diff=lfs merge=lfs -text
*.tif filter=lfs diff=lfs merge=lfs -text
*.tiff filter=lfs diff=lfs merge=lfs -text

# Collapse Unity-generated files on GitHub
*.asset linguist-generated
*.mat linguist-generated
*.meta linguist-generated
*.prefab linguist-generated
*.unity linguist-generated

# =========================
# Line endings – Unity YAML
# =========================
*.cs        text eol=lf
*.shader    text eol=lf
*.cginc     text eol=lf
*.hlsl      text eol=lf

*.asset     text eol=lf
*.prefab    text eol=lf
*.unity     text eol=lf
*.meta      text eol=lf

# =========================
# TextMesh Pro – disable merges (paths with spaces must be quoted)
# =========================
"Assets/TextMesh Pro/Fonts/*.asset" -merge
"Assets/TextMesh Pro/Fonts/**/*.asset" -merge
"Assets/TextMesh Pro/Resources/*.asset" -merge
"Assets/TextMesh Pro/Resources/**/*.asset" -merge

# Project / Settings
ProjectSettings/*.asset text eol=lf
Packages/*.json        text eol=lf
Packages/*.yml         text eol=lf

# Unity binary files
*.renderTexture  binary
*.cubemap        binary
*.lighting       binary
*.lightingData   binary
*.navmesh        binary
*.mask           binary
*.physicMaterial binary
*.unity  merge=unityyamlmerge
*.prefab merge=unityyamlmerge
*.asset  merge=unityyamlmerge
