  m_text: "\u05DC\u05D4\u05E4\u05E2\u05DC\u05EA \u05D4\u05DE\u05E9\u05D7\u05E7:\n1.
    \u05D0\u05DD \u05DC\u05D0 \u05E2\u05E9\u05D9\u05EA\u05DD \u05D0\u05EA \u05D6\u05D4
    \u05E2\u05D3\u05D9\u05D9\u05DF - \u05E4\u05EA\u05D7\u05D5 \u05D7\u05DC\u05D5\u05DF
    \u05E0\u05D5\u05E1\u05E3 \n2. \u05D9\u05E9 \u05DC\u05D4\u05EA\u05D7\u05D1\u05E8/\u05DC\u05D4\u05D9\u05E8\u05E9\u05DD
    \u05D1\u05E9\u05E0\u05D9 \u05D4\u05DE\u05E1\u05DB\u05D9\u05DD\n3. \u05DE\u05E1\u05DA
    \u05E8\u05D0\u05E9\u05D5\u05DF: \u05DC\u05D7\u05E5 \u05E2\u05DC \u05DB\u05E4\u05EA\u05D5\u05E8
    tsoh \u05D5\u05D4\u05DE\u05EA\u05DF \u05DC\u05E7\u05D1\u05DC\u05EA \u05E7\u05D5\u05D3
    \u05D4\u05EA\u05D7\u05D1\u05E8\u05D5\u05EA. \n4. \u05DE\u05E1\u05DA \u05E9\u05E0\u05D9:
    \u05D4\u05D6\u05DF \u05D0\u05EA \u05E7\u05D5\u05D3 \u05D4\u05D4\u05EA\u05D7\u05D1\u05E8\u05D5\u05EA
    \u05E9\u05D4\u05E8\u05D0\u05E9\u05D5\u05DF \u05E7\u05D9\u05D1\u05DC \u05D5\u05DC\u05D0\u05D7\u05E8
    \u05DE\u05DB\u05DF \u05DC\u05D7\u05E5 \u05E2\u05DC nioj\n5. \u05D1\u05DE\u05E1\u05DA
    \u05D4\u05E8\u05D0\u05E9\u05D5\u05DF \u05EA\u05D5\u05DB\u05DC\u05D5 \u05DC\u05D1\u05D7\u05D5\u05E8
    \u05D0\u05EA \u05E8\u05DE\u05EA \u05D4\u05DE\u05E9\u05D7\u05E7. "
