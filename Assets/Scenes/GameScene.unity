  m_text: "\u05D1\u05DE\u05D4\u05DC\u05DA \u05D4\u05DE\u05D1\u05D5\u05DA \u05D7\u05D1\u05E8\u05DA
    \u05E2\u05D5\u05DE\u05D3 \u05DC\u05D4\u05D9\u05EA\u05E7\u05DC \u05D1\u05D3\u05DC\u05EA\u05D5\u05EA,\n\u05D0\u05D7\u05EA
    \u05DE\u05D4\u05DF \u05D4\u05D9\u05D0 \u05D3\u05DC\u05EA \u05E4\u05D0\u05D6\u05DC.
    \u05D1\u05DE\u05E1\u05DA \u05D6\u05D4, \u05DE\u05D5\u05E4\u05D9\u05E2\u05D4 \u05EA\u05DE\u05D5\u05E0\u05D4,
    \u05E2\u05DC\u05D9\u05DA \u05DC\u05D4\u05E1\u05D1\u05D9\u05E8 \u05DC\u05D7\u05D1\u05E8\u05DA
    ,\u05D0\u05D9\u05E4\u05D4 \u05DB\u05DC \u05D3\u05D1\u05E8 \u05E0\u05DE\u05E6\u05D0.
    \u05D1\u05DE\u05D9\u05D3\u05EA \u05D4\u05E6\u05D5\u05E8\u05DA \u05EA\u05D5\u05DB\u05DC
