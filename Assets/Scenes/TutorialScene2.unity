    \u05E2\u05D5\u05DE\u05D3 \u05DC\u05D4\u05D9\u05EA\u05E7\u05DC \u05D1\u05D3\u05DC\u05EA\u05D5\u05EA,\n\u05D0\u05D7\u05EA
