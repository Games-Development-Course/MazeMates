  conditionType: 16
  travellerMessage: "\u05D1\u05E2\u05D6\u05E8\u05EA \u05D2\u05DC\u05D2\u05DC\u05D9
    \u05D4\u05E6\u05DC\u05D4 \u05D9\u05D5\u05E4\u05D9\u05E2 \u05DC\u05DA \u05DE\u05D9\u05E7\u05D5\u05DD
