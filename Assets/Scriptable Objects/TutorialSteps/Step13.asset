  navigatorMessage: "\u05D9\u05E4\u05D4 \u05DE\u05D0\u05D5\u05D3, \u05E0\u05EA\u05EA
    \u05DC\u05D5 \u05D0\u05EA \u05DE\u05D9\u05E7\u05D5\u05DD \u05D0\u05D7\u05EA \u05DE\u05D4\u05D3\u05DE\u05D5\u05D9\u05D5\u05EA
